{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "dialog:allow-save",
    "store:default",
    "window-state:default",
    "opener:allow-open-url"
  ]
}
